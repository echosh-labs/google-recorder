# ==============================================================================
# Google Recorder Service Configuration (Port 8082)
# ==============================================================================

PORT=8082
RECORDER_STORAGE_DIR=.data/recordings
RECORDER_AUTH_FILE=config/auth.json

# Optional: Google Recorder Web Client API Key (defaults to public client key)
GOOGLE_RECORDER_API_KEY=your_google_recorder_api_key_here

# Optional: Automatic Sync Interval (minutes)
RECORDER_SYNC_INTERVAL_MINS=15
